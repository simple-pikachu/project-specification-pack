# ============================================================
# .env.example — 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 修改 .env 中的值（特别是 LLM_API_KEY）
#   3. .env 文件已加入 .gitignore，不会提交到 Git
# ============================================================

# ──────────────────────────────────────────────────────────
# MySQL 配置
# ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=pia_root_2024
MYSQL_DATABASE=pia
MYSQL_USER=pia_user
MYSQL_PASSWORD=pia_pass
MYSQL_PORT=3306

# ──────────────────────────────────────────────────────────
# Redis 配置
# ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PASSWORD=pia_redis_2024
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────
# Qdrant 配置
# ──────────────────────────────────────────────────────────
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# ──────────────────────────────────────────────────────────
# LLM 配置（必填，替换为真实的 API Key）
# ──────────────────────────────────────────────────────────
# OpenAI 示例：
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI 示例：
# LLM_BASE_URL=https://your-resource.openai.azure.com
# LLM_API_KEY=your-azure-key
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek 示例（Chat 兼容 OpenAI 协议）：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat
# EMBEDDING_MODEL=text-embedding-3-small  # DeepSeek 暂无 Embedding，可用 OpenAI

LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ──────────────────────────────────────────────────────────
# 应用端口
# ──────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=80
SPRING_PROFILES_ACTIVE=docker
